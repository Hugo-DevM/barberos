# Copia este archivo como `.env` y rellena los dos valores.
#
# Dónde salen: en tu proyecto de Supabase, Settings > API.
#   - PUBLIC_SUPABASE_URL      = "Project URL"
#   - PUBLIC_SUPABASE_ANON_KEY = la clave "anon" / "public"
#
# El prefijo PUBLIC_ es obligatorio: Astro solo expone al navegador las
# variables que lo llevan, y el sitio es estático, así que habla con Supabase
# desde el cliente.
#
# Que la clave `anon` llegue al navegador es correcto y previsto: es pública.
# Lo que protege los datos es la seguridad a nivel de fila de
# supabase/schema.sql. NUNCA pongas aquí la clave `service_role`: esa se salta
# todas las políticas y quien la tenga puede leer la agenda entera.
#
# Si dejas este archivo sin crear, el sitio arranca igual en modo demo: las
# citas se guardan en el navegador de cada visitante y el panel entra con la
# contraseña de demostración.

PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Google Analytics 4 (opcional)
# ---------------------------------------------------------------------------
# PUBLIC_GA_ID = el "ID de medición" de la propiedad, con forma G-XXXXXXXXXX.
# Dónde sale: analytics.google.com > Administrar > Flujos de datos > el flujo
# web de este sitio > "ID de medición".
#
# Si lo dejas vacío el sitio no carga nada de Google: ni script, ni cookies.
# Así se quedan las maquetas de venta y `npm run dev`.
#
# Cada landing necesita su propio ID. Si dos comparten uno, los informes de
# los dos negocios se mezclan y ya no hay manera de separarlos.
#
# El valor se congela en el HTML al hacer `npm run build`: para cambiarlo hay
# que volver a construir y desplegar.

PUBLIC_GA_ID=
