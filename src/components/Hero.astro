---
import { Icon } from 'astro-icon/components';
import { hero, CTA_PRINCIPAL, contacto } from '../data/barberia';

const [principal, local, detalle] = hero.imagenes;
---

<section class="hero lienzo lienzo--oscuro">
  <div class="hero__caja envoltura">
    <div class="hero__texto">
      <span class="rotulo">{hero.eyebrow}</span>

      <h1>
        {hero.titulo}<br />
        <em>{hero.tituloAcento}</em>
      </h1>

      <p class="hero__entrada">{hero.entrada}</p>

      <div class="hero__botones">
        <a class="btn btn--lg" href="#reservar" data-evento="cta_reservar">
          {CTA_PRINCIPAL}
          <Icon name="ph:arrow-right" aria-hidden="true" />
        </a>
        <a class="btn btn--lg btn--linea" href="#servicios">Ver servicios y precios</a>
      </div>

      <div class="hero__prueba">
        <div class="hero__estrellas" role="img" aria-label="4.9 de 5 estrellas">
          {[0, 1, 2, 3, 4].map(() => <Icon name="ph:star-fill" aria-hidden="true" />)}
        </div>
        <p>
          <strong>4.9</strong> en 1,240 reseñas · Reservas confirmadas al instante
        </p>
      </div>
    </div>

    <div class="hero__fotos">
      <figure class="hero__foto hero__foto--arco">
        <img
          src={principal.src}
          width={principal.w}
          height={principal.h}
          alt={principal.alt}
          fetchpriority="high"
          decoding="async"
        />
      </figure>

      <figure class="hero__foto">
        <img
          src={local.src}
          width={local.w}
          height={local.h}
          alt={local.alt}
          loading="lazy"
          decoding="async"
        />
      </figure>

      <figure class="hero__foto">
        <img
          src={detalle.src}
          width={detalle.w}
          height={detalle.h}
          alt={detalle.alt}
          loading="lazy"
          decoding="async"
        />
        <figcaption class="hero__horario">
          <Icon name="ph:clock" aria-hidden="true" />
          <span>{contacto.horarios[0].dias.replace(' a ', '–')} · {contacto.horarios[0].horas}</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* La cabecera es pegajosa y transparente al inicio: el hero tiene que
       empezar por debajo de ella, no detrás. */
    margin-top: calc(var(--alto-cabecera) * -1);
    padding-top: calc(var(--alto-cabecera) + clamp(28px, 3vw, 52px));
    padding-bottom: clamp(48px, 5vw, 84px);
    overflow: clip;
  }

  /* Halo tenue tras la columna de texto: separa el titular del fondo plano
     sin meter una caja ni una línea. */
  .hero::before {
    content: '';
    position: absolute;
    top: -12%;
    left: -10%;
    width: 60%;
    height: 90%;
    background: radial-gradient(closest-side, var(--acento-halo), transparent 72%);
    pointer-events: none;
  }

  .hero__caja {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
    gap: clamp(32px, 4vw, 64px);
    align-items: center;
    min-height: clamp(500px, 72dvh, 720px);
  }

  .hero__texto { max-width: 34rem; }

  .hero h1 {
    margin-top: 22px;
    font-size: clamp(2.9rem, 6.4vw, 5.1rem);
    line-height: 0.98;
    letter-spacing: -0.032em;
  }

  .hero h1 em {
    font-style: italic;
    color: var(--acento);
  }

  .hero__entrada {
    margin-top: 22px;
    max-width: 42ch;
    color: var(--ink-2);
    font-size: clamp(1rem, 1.15vw, 1.1rem);
    line-height: 1.7;
  }

  .hero__botones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .hero__prueba {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 30px;
    padding-top: 24px;
    border-top: 1px solid var(--linea);
  }

  .hero__estrellas {
    display: inline-flex;
    gap: 2px;
    flex: none;
  }

  .hero__estrellas :global(svg) {
    width: 16px;
    height: 16px;
    color: var(--acento);
  }

  .hero__prueba p {
    font-size: 0.813rem;
    color: var(--ink-2);
  }

  .hero__prueba strong {
    color: var(--ink);
    font-weight: 600;
  }

  /* -------------------------------- Fotos -------------------------------- */

  /* La composición se mide por altura, no por proporción de cada foto: así
     llena la banda del hero en lugar de dejar un hueco arriba y otro abajo. */
  .hero__fotos {
    display: grid;
    grid-template-columns: minmax(0, 1.28fr) minmax(0, 1fr);
    grid-template-rows: 1fr 1fr;
    gap: clamp(10px, 1vw, 16px);
    height: clamp(380px, 58dvh, 580px);
  }

  .hero__foto {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-card);
    background: var(--sup);
  }

  .hero__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* El arco: la firma visual del sitio, tomada del remate de los espejos de
     barbería. Solo aquí y en las fichas del equipo. */
  .hero__foto--arco {
    grid-row: 1 / span 2;
    border-radius: var(--r-arco);
    border: 1px solid var(--linea);
  }

  .hero__horario {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 9px 12px;
    border-radius: var(--r-inner);
    background: var(--velo);
    backdrop-filter: blur(8px);
    color: var(--sobre-oscuro-ink);
    font-size: 0.719rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .hero__horario :global(svg) {
    width: 14px;
    height: 14px;
    flex: none;
    color: var(--arena);
  }

  /* ------------------------------- Cortes -------------------------------- */

  @media (max-width: 980px) {
    .hero__caja {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
      gap: 40px;
    }

    .hero__texto { max-width: 38rem; }

    /* En una sola columna el arco alto empuja todo hacia abajo. Las tres
       fotos pasan a una fila y el arco se achata. */
    .hero__fotos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: 1fr;
      height: clamp(280px, 46vw, 420px);
    }

    .hero__foto--arco {
      grid-row: auto;
      border-radius: 9rem 9rem var(--r-card) var(--r-card);
    }
  }

  @media (max-width: 620px) {
    .hero__fotos { grid-template-columns: repeat(2, minmax(0, 1fr)); }

    /* La tercera foto sobra en pantallas estrechas: repite el mensaje de las
       otras dos y obliga a hacer scroll antes de llegar a los servicios. */
    .hero__fotos > .hero__foto:nth-child(3) { display: none; }

    .hero__botones .btn { width: 100%; }
    .hero__prueba { flex-direction: column; align-items: flex-start; gap: 8px; }
  }
</style>
