  .resumen__lista {
    display: grid;
    gap: 13px;
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid var(--sobre-oscuro-linea);
  }

  .resumen__lista > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
  }

  .resumen__lista dt {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
