</style>

<style is:global>
  /* --------------------------------------------------------------------------
     Elementos que crea el JavaScript

     Astro añade su atributo de ámbito (data-astro-cid-…) solo a los nodos que
     están en la plantilla. Los días del calendario y las fichas de hora nacen
     en el navegador, así que el CSS con ámbito nunca los alcanzaría y saldrían
     sin estilo. Van aquí, sin ámbito, pero colgando de los identificadores del
     módulo: fuera de #calendario-rejilla y #horarios estas reglas no existen.
     -------------------------------------------------------------------------- */

  #calendario-rejilla .calendario__cargando {
    grid-column: 1 / -1;
    padding-block: 42px;
    text-align: center;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  #calendario-rejilla .dia {
    position: relative;
    /* Algo más anchas que altas: a cuadro perfecto el calendario se come
       media pantalla sin ganar nada en legibilidad. */
    aspect-ratio: 1 / 0.82;
    display: grid;
    place-items: center;
    border-radius: var(--r-inner);
    border: 1px solid transparent;
    font-size: 0.875rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    cursor: pointer;
    transition:
      background-color 0.16s var(--ease),
      color 0.16s var(--ease),
      border-color 0.16s var(--ease);
  }

  #calendario-rejilla .dia--hueco { visibility: hidden; }

  /* Un día con hueco tiene que verse pulsable de un vistazo. El borde solo
     no basta sobre hueso: lleva además fondo propio y el punto de abajo. */
  #calendario-rejilla .dia--libre {
    border-color: var(--linea-fuerte);
    background: var(--sup-2);
    font-weight: 600;
  }

  #calendario-rejilla .dia--libre:hover {
    background: var(--vino-900);
    color: var(--sobre-oscuro-ink);
    border-color: var(--vino-900);
  }

  /* El punto marca los días con hueco sin depender solo del color del borde. */
  #calendario-rejilla .dia--libre::after {
    content: '';
    position: absolute;
    bottom: 5px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--acento);
  }

  #calendario-rejilla .dia[disabled] {
    color: var(--ink-3);
    cursor: not-allowed;
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  #calendario-rejilla .dia--hoy { font-weight: 700; }

  /* El día elegido va con el acento del lienzo claro, no con la arena: sobre
     hueso, la arena apenas se despega del fondo. */
  #calendario-rejilla .dia--elegido,
  #calendario-rejilla .dia--elegido:hover {
    background: var(--acento);
    border-color: var(--acento);
    color: var(--acento-ink);
    font-weight: 700;
  }

  #calendario-rejilla .dia--elegido::after { background: var(--acento-ink); }

  /* El contenedor es un bloque normal y la rejilla va dentro. Con
     repeat(auto-fill, …) un `grid-column: 1 / -1` se queda en una sola
     columna, así que el mensaje de "elige un día" salía estrujado. */
  #horarios .horarios__rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(92px, 1fr));
    gap: 8px;
  }

  #horarios .horarios__vacio,
  #horarios .horarios__nada {
    padding: 22px;
    border: 1px dashed var(--linea-fuerte);
    border-radius: var(--r-card);
    text-align: center;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  #horarios .hora {
    padding: 11px 8px;
    border: 1px solid var(--linea-fuerte);
    border-radius: var(--r-inner);
    background: var(--sup);
    font-size: 0.875rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    cursor: pointer;
    transition:
      background-color 0.16s var(--ease),
      color 0.16s var(--ease),
      border-color 0.16s var(--ease);
  }

  #horarios .hora:hover:not([disabled]) {
    border-color: var(--vino-900);
    background: var(--sup-2);
  }

  #horarios .hora[aria-pressed='true'] {
    background: var(--vino-900);
    border-color: var(--vino-900);
    color: var(--sobre-oscuro-ink);
    font-weight: 600;
  }

  /* Hora ya reservada: se ve, para que se note que la barbería está llena a
     esa hora, pero no se puede elegir. El tachado la distingue sin depender
     solo del color. */
  #horarios .hora[disabled] {
    background: transparent;
    border-style: dashed;
    border-color: var(--linea);
    color: var(--ink-3);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
    cursor: not-allowed;
  }

  #horarios .horarios__pie {
    margin-top: 11px;
    font-size: 0.75rem;
    color: var(--ink-2);
  }

  @media (max-width: 560px) {
    #horarios .horarios__rejilla {
      grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
    }
  }
</style>

<script>
  import {
    cargarAgenda,
    reservar,
    huecosDelDia,
    diaTieneHuecos,
    ahoraEnBarberia,
    instanteUtc,
    fechaLegible,
    horaLegible,
    partesFecha,
    aFecha,
    diaSemana,
    diasEnMes,
    sumarDias,
    subirComprobante,
    tiempoRestante,
    ErrorReserva,
    HAY_SUPABASE,
    type Agenda,
    type EstadoPago,
  } from '../lib/reservas';
  import { reserva, contacto, marca, pago, servicios as catalogo } from '../data/barberia';

  const formulario = document.getElementById('form-reserva') as HTMLFormElement | null;
  if (formulario) iniciar(formulario);

  function iniciar(formulario: HTMLFormElement) {
    /* ------------------------------- Estado ------------------------------- */

    const hoy = ahoraEnBarberia().fecha;
    const ultimoDia = sumarDias(hoy, reserva.diasDeAntelacion);

    let agenda: Agenda | null = null;
    let mesVisible = { anio: partesFecha(hoy).anio, mes: partesFecha(hoy).mes };
    let diaElegido: string | null = null;
    let horaElegida: string | null = null;

    const dinero = new Intl.NumberFormat('es-MX', {
      style: 'currency',
      currency: 'MXN',
      minimumFractionDigits: 0,
      maximumFractionDigits: 0,
    });

    const nombreMes = new Intl.DateTimeFormat('es-MX', {
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    });

    /* ------------------------------- Nodos -------------------------------- */

    const rejilla = document.getElementById('calendario-rejilla')!;
    const tituloMes = document.getElementById('mes-titulo')!;
    const atras = document.getElementById('mes-atras') as HTMLButtonElement;
    const adelante = document.getElementById('mes-adelante') as HTMLButtonElement;
    const cajaHorarios = document.getElementById('horarios')!;
    const avisoHorarios = document.getElementById('horarios-aviso')!;
    const aviso = document.getElementById('reserva-aviso')!;
    const boton = document.getElementById('enviar-reserva') as HTMLButtonElement;
    const confirmada = document.getElementById('confirmada')!;

    const resumen = {
      servicio: document.getElementById('res-servicio')!,
      barbero: document.getElementById('res-barbero')!,
      dia: document.getElementById('res-dia')!,
      hora: document.getElementById('res-hora')!,
      total: document.getElementById('res-total')!,
      anticipoCaja: document.getElementById('res-anticipo-caja')!,
      anticipo: document.getElementById('res-anticipo')!,
      resta: document.getElementById('res-resta')!,
      nota: document.getElementById('res-nota')!,
      notaEnviar: document.getElementById('enviar-nota')!,
    };

    function servicioElegido() {
      const radio = formulario.querySelector<HTMLInputElement>('input[name="servicio"]:checked')!;
      return {
        slug: radio.value,
        nombre: radio.dataset.nombre!,
        precio: Number(radio.dataset.precio),
        duracion: Number(radio.dataset.duracion),
        anticipo: Number(radio.dataset.anticipo ?? 0),
      };
    }

    function barberoElegido() {
      const radio = formulario.querySelector<HTMLInputElement>('input[name="barbero"]:checked')!;
      return {
        slug: radio.value || null,
        nombre: radio.dataset.nombre!,
      };
    }

    /* ------------------------------- Analítica ----------------------------- */

    /* El embudo de reserva en dos eventos: uno cuando alguien empieza a
       llenarlo de verdad y otro cuando la cita queda hecha. Sin el primero,
       una caída en las reservas no distingue entre "llega menos gente" y "la
       gente se atora a medio formulario".

       Se llama con `?.` porque el ayudante solo existe si hay PUBLIC_GA_ID:
       sin analítica configurada el formulario funciona igual. */
    let inicioMedido = false;

    function medirInicio() {
      if (inicioMedido) return;
      inicioMedido = true;
      window.medirEvento?.('inicio_reserva', { servicio: servicioElegido().nombre });
    }

    formulario.addEventListener('input', medirInicio, { once: true });

    /* ------------------------------ Calendario ----------------------------- */

    function pintarCalendario() {
      const { anio, mes } = mesVisible;
      // "septiembre de 2026" -> "Septiembre de 2026". Con text-transform:
      // capitalize el "de" también saldría en mayúscula.
      const etiqueta = nombreMes.format(new Date(Date.UTC(anio, mes - 1, 1)));
      tituloMes.textContent = etiqueta.charAt(0).toUpperCase() + etiqueta.slice(1);

      // Los meses fuera de la ventana de agenda no se pueden alcanzar.
      const primeroDelMes = aFecha(anio, mes, 1);
      const ultimoDelMes = aFecha(anio, mes, diasEnMes(anio, mes));
      atras.disabled = primeroDelMes <= hoy;
      adelante.disabled = ultimoDelMes >= ultimoDia;

      rejilla.replaceChildren();

      if (!agenda) {
        const cargando = document.createElement('p');
        cargando.className = 'calendario__cargando';
        cargando.textContent = 'Cargando disponibilidad…';
        rejilla.append(cargando);
        return;
      }

      const servicio = servicioElegido();
      const barbero = barberoElegido();

      // La rejilla empieza en lunes: diaSemana() devuelve 0 para domingo.
      const desfase = (diaSemana(primeroDelMes) + 6) % 7;
      for (let i = 0; i < desfase; i++) {
        const hueco = document.createElement('span');
        hueco.className = 'dia dia--hueco';
        hueco.setAttribute('aria-hidden', 'true');
        rejilla.append(hueco);
      }

      for (let numero = 1; numero <= diasEnMes(anio, mes); numero++) {
        const fecha = aFecha(anio, mes, numero);
        const celda = document.createElement('button');
        celda.type = 'button';
        celda.className = 'dia';
        celda.textContent = String(numero);
        celda.dataset.fecha = fecha;

        const dentroDeVentana = fecha >= hoy && fecha <= ultimoDia;
        const libre = dentroDeVentana && diaTieneHuecos(agenda, fecha, servicio.duracion, barbero.slug);

        if (fecha === hoy) celda.classList.add('dia--hoy');

        if (!libre) {
          celda.disabled = true;
          celda.setAttribute(
            'aria-label',
            `${fechaLegible(fecha)}, sin horarios disponibles`
          );
        } else {
          celda.classList.add('dia--libre');
          celda.setAttribute('aria-label', fechaLegible(fecha));
          celda.addEventListener('click', () => elegirDia(fecha));
        }

        if (fecha === diaElegido) {
          celda.classList.add('dia--elegido');
          celda.setAttribute('aria-current', 'date');
        }

        rejilla.append(celda);
      }
    }

    function elegirDia(fecha: string) {
      medirInicio();
      diaElegido = fecha;
      horaElegida = null;
      pintarCalendario();
      pintarHorarios();
      actualizarResumen();
    }

    /* ------------------------------- Horarios ------------------------------ */

    function pintarHorarios() {
      cajaHorarios.replaceChildren();

      if (!diaElegido || !agenda) {
        const vacio = document.createElement('p');
        vacio.className = 'horarios__vacio';
        vacio.textContent = 'Elige primero un día.';
        cajaHorarios.append(vacio);
        return;
      }

      const servicio = servicioElegido();
      const barbero = barberoElegido();
      const huecos = huecosDelDia(agenda, diaElegido, servicio.duracion, barbero.slug);

      if (huecos.length === 0) {
        const nada = document.createElement('p');
        nada.className = 'horarios__nada';
        nada.textContent = 'Ese día ya no queda nada. Prueba con otro.';
        cajaHorarios.append(nada);
        avisoHorarios.textContent = `Sin horarios libres el ${fechaLegible(diaElegido)}.`;
        return;
      }

      const rejillaHoras = document.createElement('div');
      rejillaHoras.className = 'horarios__rejilla';

      huecos.forEach((hueco) => {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'hora';
        chip.textContent = horaLegible(hueco.hora);

        if (hueco.libres === 0) {
          // Se muestra, pero no se puede elegir. El lector de pantalla tiene
          // que oír el motivo, no solo encontrarse un botón apagado.
          chip.disabled = true;
          chip.setAttribute('aria-label', `${horaLegible(hueco.hora)}, ya reservado`);
          chip.title = 'Ya reservado';
        } else {
          chip.setAttribute('aria-pressed', String(hueco.hora === horaElegida));
          chip.addEventListener('click', () => {
            horaElegida = hueco.hora;
            pintarHorarios();
            actualizarResumen();
          });
        }

        rejillaHoras.append(chip);
      });

      cajaHorarios.append(rejillaHoras);

      const libres = huecos.filter((h) => h.libres > 0).length;
      const pie = document.createElement('p');
      pie.className = 'horarios__pie';
      pie.textContent =
        libres === 0
          ? 'Todas las horas de ese día están tomadas.'
          : `${libres} de ${huecos.length} horas libres. Las tachadas ya están reservadas.`;
      cajaHorarios.append(pie);

      avisoHorarios.textContent = `${libres} horarios libres de ${huecos.length} el ${fechaLegible(diaElegido)}.`;
    }

    /* ------------------------------- Resumen ------------------------------- */

    function actualizarResumen() {
      const servicio = servicioElegido();
      const barbero = barberoElegido();

      resumen.servicio.textContent = `${servicio.nombre} · ${servicio.duracion} min`;
      resumen.barbero.textContent = barbero.nombre;
      resumen.total.textContent = dinero.format(servicio.precio);

      /* Con anticipo cambian tres cosas a la vez: aparece el renglón del
         depósito, la promesa de "queda apartado al confirmar" deja de ser
         cierta, y la nota de "no pedimos tarjeta" también. Si una se actualiza
         y otra no, la página se contradice sola. */
      const conAnticipo = servicio.anticipo > 0;
      resumen.anticipoCaja.hidden = !conAnticipo;

      if (conAnticipo) {
        resumen.anticipo.textContent = dinero.format(servicio.anticipo);
        resumen.resta.textContent = `Pagas ${dinero.format(servicio.precio - servicio.anticipo)} el día de la cita`;
        resumen.nota.textContent =
          `El hueco se aparta ${pago.plazoHoras} horas mientras llega tu transferencia. En cuanto la verificamos, la cita queda confirmada.`;
        resumen.notaEnviar.textContent =
          'Sin tarjeta: el anticipo se manda por transferencia y no lleva comisión.';
      } else {
        resumen.nota.textContent =
          'El hueco queda apartado en cuanto confirmas. Puedes cancelar hasta 2 horas antes.';
        resumen.notaEnviar.textContent = 'No pedimos tarjeta. Pagas en el local, al terminar.';
      }

      resumen.dia.textContent = diaElegido ? fechaLegible(diaElegido) : 'Sin elegir';
      resumen.dia.dataset.vacio = String(!diaElegido);

      resumen.hora.textContent = horaElegida ? horaLegible(horaElegida) : 'Sin elegir';
      resumen.hora.dataset.vacio = String(!horaElegida);
    }

    /* -------------------------- Carga de la agenda ------------------------- */

    let ultimaCarga = 0;

    async function traerAgenda() {
      try {
        agenda = await cargarAgenda(hoy, ultimoDia);
        ultimaCarga = Date.now();
      } catch {
        mostrarAviso(
          'error',
          `No pudimos cargar la agenda. Recarga la página o llámanos al ${contacto.telefono}.`
        );
        agenda = { horarios: [], barberos: [], ocupados: [], bloqueos: [] };
      }
      pintarCalendario();
      pintarHorarios();
    }

    /* Comprueba que lo ya elegido siga existiendo tras recargar la agenda.
       Si el hueco se lo llevó alguien, se limpia y se avisa, en vez de dejar
       al cliente escribir sus datos para que el servidor lo rechace al final. */
    function revalidarSeleccion() {
      if (!agenda) return;
      const servicio = servicioElegido();
      const barbero = barberoElegido();

      if (diaElegido && !diaTieneHuecos(agenda, diaElegido, servicio.duracion, barbero.slug)) {
        diaElegido = null;
        horaElegida = null;
        mostrarAviso('error', 'Ese día se llenó mientras tenías la página abierta. Elige otro.');
        return;
      }

      if (diaElegido && horaElegida) {
        const sigueLibre = huecosDelDia(
          agenda,
          diaElegido,
          servicio.duracion,
          barbero.slug
        ).some((hueco) => hueco.hora === horaElegida && hueco.libres > 0);

        if (!sigueLibre) {
          horaElegida = null;
          mostrarAviso('error', 'Alguien apartó ese horario hace un momento. Elige otro.');
        }
      }
    }

    /* La agenda se pide al cargar la página. Si alguien deja la pestaña
       abierta y vuelve media hora después, lo que ve puede haber dejado de
       ser cierto: al recuperar el foco se vuelve a pedir. El servidor manda
       de todos modos, pero más vale que el calendario no mienta entretanto. */
    document.addEventListener('visibilitychange', async () => {
      if (document.visibilityState !== 'visible') return;
      if (!confirmada.hidden) return; // ya reservó: no tocar la confirmación
      if (Date.now() - ultimaCarga < 60_000) return;

      await traerAgenda();
      revalidarSeleccion();
      pintarCalendario();
      pintarHorarios();
      actualizarResumen();
    });

    /* ------------------------------ Validación ----------------------------- */

    const reglas: Record<string, (valor: string) => string | null> = {
      nombre: (v) => {
        if (!v.trim()) return 'Escribe tu nombre.';
        if (v.trim().length < 3) return 'El nombre parece demasiado corto.';
        return null;
      },
      telefono: (v) => {
        const digitos = v.replace(/\D/g, '');
        if (!digitos) return 'Necesitamos un teléfono para confirmarte.';
        if (digitos.length < 10) return 'Faltan dígitos. Escribe los 10 del número.';
        if (digitos.length > 13) return 'Ese número tiene dígitos de más.';
        return null;
      },
      correo: (v) => {
        if (!v.trim()) return null;
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim())) return 'Revisa el correo, algo no cuadra.';
        return null;
      },
      aviso: (v) => (v === 'on' ? null : 'Necesitamos tu autorización para confirmarte.'),
    };

    function valorDe(control: HTMLInputElement | HTMLTextAreaElement) {
      if (control instanceof HTMLInputElement && control.type === 'checkbox') {
        return control.checked ? 'on' : '';
      }
      return control.value;
    }

    function pintarError(control: HTMLElement, mensaje: string | null) {
      const campo = control.closest<HTMLElement>('.campo');
      if (!campo) return;
      const caja = campo.querySelector<HTMLElement>('[data-error]');
      const texto = caja?.querySelector('span');

      if (mensaje) {
        campo.setAttribute('data-invalido', '');
        control.setAttribute('aria-invalid', 'true');
        if (caja && texto) {
          texto.textContent = mensaje;
          caja.hidden = false;
        }
      } else {
        campo.removeAttribute('data-invalido');
        control.removeAttribute('aria-invalid');
        if (caja) caja.hidden = true;
      }
    }

    function validar(control: HTMLInputElement | HTMLTextAreaElement) {
      const regla = reglas[control.name];
      if (!regla) return true;
      const mensaje = regla(valorDe(control));
      pintarError(control, mensaje);
      return mensaje === null;
    }

    const controles = Array.from(
      formulario.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
        '#r-nombre, #r-telefono, #r-correo, #r-aviso'
      )
    );

    controles.forEach((control) => {
      // Se valida al salir del campo, no mientras se escribe: corregir a
      // media palabra produce errores que aparecen y desaparecen solos.
      control.addEventListener('blur', () => validar(control));
      control.addEventListener('change', () => {
        if (control.closest('.campo')?.hasAttribute('data-invalido')) validar(control);
      });
    });

    /* -------------------------------- Avisos ------------------------------- */

    function mostrarAviso(tono: 'ok' | 'error', mensaje: string) {
      aviso.dataset.tono = tono;
      aviso.textContent = mensaje;
      aviso.hidden = false;
    }

    function ocultarAviso() {
      aviso.hidden = true;
    }

    function cargando(activo: boolean) {
      boton.dataset.cargando = String(activo);
      boton.disabled = activo;
      const texto = boton.querySelector('.enviar__texto');
      if (texto) texto.textContent = activo ? 'Apartando tu lugar' : 'Reservar cita';
    }

    /* ------------------------------ Confirmación ---------------------------- */

    /* Archivo .ics con hora local flotante: sin TZID ni Z, los calendarios lo
       interpretan en la zona del dispositivo, que para una cita presencial es
       justo lo que se quiere. */
    function archivoCalendario(datos: {
      folio: string;
      servicio: string;
      barbero: string;
      fecha: string;
      hora: string;
      duracion: number;
    }) {
      /* Marca de tiempo absoluta (acaba en Z). No se usa la hora "suelta"
         porque quien reserve desde otro huso vería la cita a esa hora de su
         zona, no de la nuestra. */
      const sello = (instante: Date) =>
        instante.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');

      const escapar = (t: string) => t.replace(/([,;\\])/g, '\\$1').replace(/\n/g, '\\n');

      /* RFC 5545: ninguna línea puede pasar de 75 octetos. Las que se pasan se
         parten y la continuación arranca con un espacio. Se mide en bytes UTF-8
         y se corta por carácter, para no dejar media eñe en cada trozo.
         Sin esto, la dirección del local rompe importaciones estrictas. */
      const plegar = (linea: string) => {
        const medir = (t: string) => new TextEncoder().encode(t).length;
        if (medir(linea) <= 75) return linea;

        const trozos: string[] = [];
        let actual = '';
        let tope = 75;

        for (const caracter of linea) {
          if (medir(actual + caracter) > tope) {
            trozos.push(actual);
            actual = caracter;
            tope = 74; // la continuación gasta un octeto en el espacio inicial
          } else {
            actual += caracter;
          }
        }
        trozos.push(actual);

        return trozos.join('\r\n ');
      };

      const lineas = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        `PRODID:-//${marca.nombre}//Reservas//ES`,
        'CALSCALE:GREGORIAN',
        'BEGIN:VEVENT',
        `UID:${datos.folio}@${marca.dominio}`,
        `DTSTAMP:${sello(new Date())}`,
        `DTSTART:${sello(instanteUtc(datos.fecha, datos.hora))}`,
        `DTEND:${sello(instanteUtc(datos.fecha, datos.hora, datos.duracion))}`,
        `SUMMARY:${escapar(`${datos.servicio} en ${marca.nombre}`)}`,
        `LOCATION:${escapar(`${contacto.calle}, ${contacto.colonia}, ${contacto.cp}`)}`,
        `DESCRIPTION:${escapar(`Folio ${datos.folio}. Te atiende ${datos.barbero}. Tel. ${contacto.telefono}`)}`,
        'BEGIN:VALARM',
        'TRIGGER:-PT2H',
        'ACTION:DISPLAY',
        `DESCRIPTION:${escapar(`Tu cita en ${marca.nombre} es en 2 horas`)}`,
        'END:VALARM',
        'END:VEVENT',
        'END:VCALENDAR',
      ];

      return URL.createObjectURL(
        new Blob([lineas.map(plegar).join('\r\n')], { type: 'text/calendar;charset=utf-8' })
      );
    }

    /* Enlaces directos a los calendarios web. Google y Outlook aceptan el
       evento en la propia URL, así que desde la computadora se abre la pestaña
       con la cita ya cargada y solo hay que darle a guardar: nada que
       descargar ni que buscar después en la carpeta de descargas. */
    function enlacesCalendario(datos: {
      folio: string;
      servicio: string;
      barbero: string;
      fecha: string;
      hora: string;
      duracion: number;
    }) {
      const inicio = instanteUtc(datos.fecha, datos.hora);
      const fin = instanteUtc(datos.fecha, datos.hora, datos.duracion);
      const compacto = (d: Date) =>
        d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');

      const titulo = `${datos.servicio} en ${marca.nombre}`;
      const lugar = `${contacto.calle}, ${contacto.colonia}, ${contacto.cp}`;
      const detalle =
        `Folio ${datos.folio}. Te atiende ${datos.barbero}. ` +
        `Tel. ${contacto.telefono}`;

      const google = new URL('https://calendar.google.com/calendar/render');
      google.searchParams.set('action', 'TEMPLATE');
      google.searchParams.set('text', titulo);
      google.searchParams.set('dates', `${compacto(inicio)}/${compacto(fin)}`);
      google.searchParams.set('details', detalle);
      google.searchParams.set('location', lugar);

      const outlook = new URL('https://outlook.live.com/calendar/0/deeplink/compose');
      outlook.searchParams.set('path', '/calendar/action/compose');
      outlook.searchParams.set('rru', 'addevent');
      outlook.searchParams.set('subject', titulo);
      outlook.searchParams.set('startdt', inicio.toISOString());
      outlook.searchParams.set('enddt', fin.toISOString());
      outlook.searchParams.set('body', detalle);
      outlook.searchParams.set('location', lugar);

      return { google: google.href, outlook: outlook.href };
    }

    let urlCalendario: string | null = null;

    /* Datos de la cita que se acaba de hacer. Los necesita la subida del
       comprobante, que ocurre después de que el formulario ya se limpió. */
    let citaEnCurso: { folio: string; telefono: string } | null = null;
    let relojAnticipo: number | null = null;

    /* -------------------------- Pantalla del anticipo ----------------------- */

    const cajaAnticipo = document.getElementById('anticipo')!;
    const formComprobante = document.getElementById('form-comprobante') as HTMLFormElement;
    const campoComprobante = document.getElementById('comprobante') as HTMLInputElement;
    const botonComprobante = document.getElementById('comprobante-enviar') as HTMLButtonElement;
    const avisoComprobante = document.getElementById('comprobante-aviso')!;
    const listoAnticipo = document.getElementById('anticipo-listo')!;
    const relojTexto = document.getElementById('anticipo-reloj')!;

    /* La cuenta atrás se refresca cada 30 segundos. No es un temporizador
       exacto ni pretende serlo: quien manda el anticipo necesita saber si le
       quedan dos horas o diez minutos, no los segundos. Cuando se agota, el
       servidor ya habrá soltado el hueco, así que se dice y se deja de contar. */
    function pintarReloj(venceEn: string | null) {
      if (relojAnticipo !== null) {
        clearInterval(relojAnticipo);
        relojAnticipo = null;
      }

      if (!venceEn) {
        relojTexto.hidden = true;
        return;
      }

      const refrescar = () => {
        const falta = tiempoRestante(venceEn);
        if (falta) {
          relojTexto.textContent = `Te quedan ${falta} para mandar el anticipo.`;
          relojTexto.dataset.agotado = 'false';
        } else {
          relojTexto.textContent =
            'Se acabó el plazo y el hueco volvió a quedar libre. Si ya transferiste, llámanos y lo resolvemos.';
          relojTexto.dataset.agotado = 'true';
          if (relojAnticipo !== null) clearInterval(relojAnticipo);
          relojAnticipo = null;
        }
      };

      relojTexto.hidden = false;
      refrescar();
      relojAnticipo = window.setInterval(refrescar, 30_000);
    }

    function mostrarAvisoComprobante(tono: 'ok' | 'error', mensaje: string) {
      avisoComprobante.dataset.tono = tono;
      avisoComprobante.textContent = mensaje;
      avisoComprobante.hidden = false;
    }

    function marcarComprobanteRecibido() {
      formComprobante.hidden = true;
      listoAnticipo.hidden = false;
      avisoComprobante.hidden = true;
      pintarReloj(null);
    }

    function mostrarConfirmacion(datos: {
      folio: string;
      servicio: string;
      barbero: string;
      fecha: string;
      hora: string;
      duracion: number;
      telefono: string;
      anticipo: number;
      pagoEstado: EstadoPago;
      venceEn: string | null;
    }) {
      document.getElementById('conf-folio')!.textContent = datos.folio;
      document.getElementById('conf-servicio')!.textContent = datos.servicio;
      document.getElementById('conf-barbero')!.textContent = datos.barbero;
      document.getElementById('conf-cuando')!.textContent =
        `${fechaLegible(datos.fecha)}, ${horaLegible(datos.hora)}`;

      citaEnCurso = { folio: datos.folio, telefono: datos.telefono };

      const esperaAnticipo = datos.anticipo > 0 && datos.pagoEstado === 'esperando';

      // El título y el texto tienen que decir la verdad del momento: con el
      // anticipo pendiente, la cita NO está apartada en firme todavía.
      const titulo = confirmada.querySelector('h3') as HTMLElement;
      titulo.textContent = esperaAnticipo
        ? 'Ya casi: falta el anticipo'
        : 'Listo, tu lugar está apartado';

      if (esperaAnticipo) {
        document.getElementById('conf-texto')!.textContent = HAY_SUPABASE
          ? 'Guardamos tu cita y te apartamos el lugar mientras llega la transferencia.'
          : 'Esta demostración guarda la cita solo en este navegador. Con Supabase conectado, el comprobante llegaría al panel de la barbería para revisarlo.';
      } else {
        document.getElementById('conf-texto')!.textContent = HAY_SUPABASE
          ? 'Te mandamos un recordatorio por WhatsApp el día anterior. Si te surge algo, avísanos con dos horas de anticipación y liberamos el lugar.'
          : 'Esta demostración guarda la cita solo en este navegador. Con Supabase conectado, la cita llegaría al panel de la barbería al instante.';
      }

      cajaAnticipo.hidden = !esperaAnticipo;

      if (esperaAnticipo) {
        document.getElementById('anticipo-monto')!.textContent = dinero.format(datos.anticipo);
        document.getElementById('anticipo-folio')!.textContent = datos.folio;
        (document.getElementById('copiar-folio') as HTMLButtonElement).dataset.copiar = datos.folio;

        // Cada reserva empieza con el formulario limpio: si alguien agenda dos
        // rituales seguidos, el segundo no puede heredar el "ya lo mandaste".
        formComprobante.hidden = false;
        formComprobante.reset();
        listoAnticipo.hidden = true;
        avisoComprobante.hidden = true;
        pintarReloj(datos.venceEn);
      } else {
        pintarReloj(null);
      }

      const { google, outlook } = enlacesCalendario(datos);
      (document.getElementById('cal-google') as HTMLAnchorElement).href = google;
      (document.getElementById('cal-outlook') as HTMLAnchorElement).href = outlook;

      if (urlCalendario) URL.revokeObjectURL(urlCalendario);
      urlCalendario = archivoCalendario(datos);
      (document.getElementById('cal-ics') as HTMLAnchorElement).href = urlCalendario;

      /* Que el cliente escriba primero no es un detalle de cortesía: abre la
         ventana de servicio de WhatsApp, y dentro de ella la barbería puede
         responder y recordar sin pagar por plantilla. */
      const mensaje = [
        `Hola, soy ${datos.folio.replace('NF-', '')}. Acabo de reservar en ${marca.nombre}.`,
        `${datos.servicio} con ${datos.barbero}`,
        `${fechaLegible(datos.fecha)}, ${horaLegible(datos.hora)}`,
        `Folio: ${datos.folio}`,
        ...(esperaAnticipo ? [`Voy a mandar el anticipo de ${dinero.format(datos.anticipo)}.`] : []),
      ].join('\n');

      (document.getElementById('conf-whatsapp') as HTMLAnchorElement).href =
        `https://wa.me/${contacto.whatsapp}?text=${encodeURIComponent(mensaje)}`;

      formulario.hidden = true;
      confirmada.hidden = false;
      confirmada.scrollIntoView({
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
          ? 'auto'
          : 'smooth',
        block: 'center',
      });
      (confirmada.querySelector('h3') as HTMLElement).setAttribute('tabindex', '-1');
      (confirmada.querySelector('h3') as HTMLElement).focus();
    }

    /* ------------------------ Menú de calendarios --------------------------- */

    const calAbrir = document.getElementById('cal-abrir') as HTMLButtonElement;
    const calLista = document.getElementById('cal-lista')!;
    const calOpciones = Array.from(calLista.querySelectorAll<HTMLAnchorElement>('a'));

    function abrirCalendarios(abierto: boolean) {
      calLista.hidden = !abierto;
      calAbrir.setAttribute('aria-expanded', String(abierto));
      if (abierto) calOpciones[0]?.focus();
    }

    calAbrir.addEventListener('click', () => abrirCalendarios(calLista.hidden));

    // Elegir un calendario cierra el menú; el enlace sigue su camino.
    calOpciones.forEach((opcion) => {
      opcion.addEventListener('click', () => abrirCalendarios(false));
    });

    document.addEventListener('click', (evento) => {
      const dentro = (evento.target as HTMLElement).closest('#calendarios');
      if (!dentro && !calLista.hidden) abrirCalendarios(false);
    });

    calLista.addEventListener('keydown', (evento) => {
      const indice = calOpciones.indexOf(document.activeElement as HTMLAnchorElement);
      if (evento.key === 'ArrowDown') {
        evento.preventDefault();
        calOpciones[(indice + 1) % calOpciones.length].focus();
      } else if (evento.key === 'ArrowUp') {
        evento.preventDefault();
        calOpciones[(indice - 1 + calOpciones.length) % calOpciones.length].focus();
      }
    });

    document.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape' && !calLista.hidden) {
        abrirCalendarios(false);
        calAbrir.focus();
      }
    });

    document.getElementById('conf-otra')!.addEventListener('click', async () => {
      confirmada.hidden = true;
      formulario.hidden = false;
      diaElegido = null;
      horaElegida = null;
      ocultarAviso();
      // Se apaga la pantalla del anticipo y su reloj: dejarlo corriendo de
      // fondo gastaría un intervalo por cada cita que se agende.
      cajaAnticipo.hidden = true;
      citaEnCurso = null;
      pintarReloj(null);
      // La agenda cambió: el hueco que se acaba de tomar ya no está libre.
      await traerAgenda();
      actualizarResumen();
      formulario.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    /* ------------------------ Copiar CLABE y folio -------------------------- */

    /* Nadie teclea a mano una CLABE de 18 dígitos sin equivocarse, y un dígito
       mal puesto manda el dinero a otra cuenta. El botón de copiar no es un
       adorno: es lo que evita que el anticipo se pierda. */
    cajaAnticipo.querySelectorAll<HTMLButtonElement>('.anticipo__copiar').forEach((boton) => {
      boton.addEventListener('click', async () => {
        const valor = boton.dataset.copiar;
        if (!valor) return;

        const etiqueta = boton.querySelector('span')!;
        const original = etiqueta.textContent;

        try {
          await navigator.clipboard.writeText(valor);
          etiqueta.textContent = 'Copiado';
          boton.dataset.copiado = 'true';
        } catch {
          // Safari sin permiso de portapapeles, o contexto no seguro. Se
          // selecciona el texto para que al menos se pueda copiar a mano.
          const dato = boton.previousElementSibling;
          if (dato) {
            const rango = document.createRange();
            rango.selectNodeContents(dato);
            const seleccion = window.getSelection();
            seleccion?.removeAllRanges();
            seleccion?.addRange(rango);
          }
          etiqueta.textContent = 'Selecciónalo';
        }

        window.setTimeout(() => {
          etiqueta.textContent = original;
          delete boton.dataset.copiado;
        }, 2000);
      });
    });

    /* --------------------------- Envío del comprobante ---------------------- */

    function cargandoComprobante(activo: boolean) {
      botonComprobante.dataset.cargando = String(activo);
      botonComprobante.disabled = activo;
      const texto = botonComprobante.querySelector('.comprobante__texto');
      if (texto) texto.textContent = activo ? 'Subiendo' : 'Enviar comprobante';
    }

    formComprobante.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      avisoComprobante.hidden = true;

      const archivo = campoComprobante.files?.[0];
      if (!archivo) {
        mostrarAvisoComprobante('error', 'Elige la captura de tu transferencia.');
        campoComprobante.focus();
        return;
      }

      if (!citaEnCurso) {
        mostrarAvisoComprobante(
          'error',
          `No encontramos tu reserva en esta pantalla. Mándanos el comprobante por WhatsApp al ${contacto.telefono}.`
        );
        return;
      }

      cargandoComprobante(true);

      try {
        await subirComprobante({
          folio: citaEnCurso.folio,
          telefono: citaEnCurso.telefono,
          archivo,
        });

        marcarComprobanteRecibido();
        window.medirEvento?.('comprobante_subido', { folio: citaEnCurso.folio });
      } catch (error) {
        const mensaje =
          error instanceof ErrorReserva
            ? error.message
            : `No pudimos subir el comprobante. Mándanoslo por WhatsApp al ${contacto.telefono}.`;
        mostrarAvisoComprobante('error', mensaje);
      } finally {
        cargandoComprobante(false);
      }
    });

    /* --------------------------------- Envío -------------------------------- */

    formulario.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      ocultarAviso();

      if (!diaElegido || !horaElegida) {
        mostrarAviso('error', 'Falta elegir el día y la hora de tu cita.');
        document.getElementById('calendario')?.scrollIntoView({ block: 'center' });
        return;
      }

      const validos = controles.map((c) => validar(c));
      if (validos.includes(false)) {
        const primerFallo = formulario.querySelector<HTMLElement>(
          '[data-invalido] input, [data-invalido] textarea'
        );
        primerFallo?.focus();
        mostrarAviso('error', 'Revisa los campos marcados y vuelve a enviar.');
        return;
      }

      const servicio = servicioElegido();
      const barbero = barberoElegido();
      const datos = new FormData(formulario);

      cargando(true);

      const telefono = String(datos.get('telefono') ?? '');

      try {
        /* Solo viaja QUÉ se eligió. El precio, la duración y el anticipo los
           pone la base de datos; lo que vuelve en `hecha` es lo que quedó
           guardado de verdad, y es eso lo que se pinta. */
        const hecha = await reservar({
          nombre: String(datos.get('nombre') ?? ''),
          telefono,
          correo: String(datos.get('correo') ?? '') || null,
          servicioSlug: servicio.slug,
          barberoSlug: barbero.slug,
          fecha: diaElegido,
          hora: horaElegida,
          notas: String(datos.get('notas') ?? '') || null,
        });

        mostrarConfirmacion({
          folio: hecha.folio,
          servicio: hecha.servicioNombre,
          barbero: hecha.barberoNombre,
          fecha: diaElegido,
          hora: horaElegida,
          duracion: hecha.duracionMin,
          telefono,
          anticipo: hecha.anticipo,
          pagoEstado: hecha.pagoEstado,
          venceEn: hecha.venceEn,
        });

        /* La conversión. `value` va en pesos para que el informe muestre el
           dinero agendado, no solo el número de citas. En GA4 hay que marcar
           este evento como evento clave. */
        window.medirEvento?.('reserva_completada', {
          servicio: hecha.servicioNombre,
          barbero: hecha.barberoNombre,
          value: hecha.precio,
          currency: 'MXN',
          anticipo: hecha.anticipo,
        });

        formulario.reset();
      } catch (error) {
        const mensaje =
          error instanceof ErrorReserva
            ? error.message
            : `No pudimos guardar la cita. Llámanos al ${contacto.telefono} y la agendamos por teléfono.`;

        mostrarAviso('error', mensaje);

        // Si el hueco se lo ganó alguien más, la agenda que tenemos en
        // pantalla ya miente: hay que volver a pedirla.
        if (error instanceof ErrorReserva && error.codigo === 'HORA_OCUPADA') {
          horaElegida = null;
          await traerAgenda();
          actualizarResumen();
        }
      } finally {
        cargando(false);
      }
    });

    /* ------------------------- Cambios de selección -------------------------- */

    formulario.querySelectorAll<HTMLInputElement>('input[name="servicio"], input[name="barbero"]')
      .forEach((radio) => {
        radio.addEventListener('change', () => {
          // Cambiar de servicio o de barbero cambia qué huecos caben: la hora
          // elegida puede haber dejado de existir.
          horaElegida = null;
          if (diaElegido && agenda) {
            const s = servicioElegido();
            const b = barberoElegido();
            if (!diaTieneHuecos(agenda, diaElegido, s.duracion, b.slug)) diaElegido = null;
          }
          pintarCalendario();
          pintarHorarios();
          actualizarResumen();
        });
      });

    /* Las tarjetas de servicio de más arriba mandan aquí con el servicio ya
       elegido. */
    document.addEventListener('elegir-servicio', (evento) => {
      const slug = (evento as CustomEvent<{ slug: string }>).detail?.slug;
      if (!slug || !catalogo.some((s) => s.slug === slug)) return;
      const radio = formulario.querySelector<HTMLInputElement>(
        `input[name="servicio"][value="${slug}"]`
      );
      if (radio && !radio.checked) {
        radio.checked = true;
        radio.dispatchEvent(new Event('change', { bubbles: true }));
      }
    });

    atras.addEventListener('click', () => {
      mesVisible = mesVisible.mes === 1
        ? { anio: mesVisible.anio - 1, mes: 12 }
        : { anio: mesVisible.anio, mes: mesVisible.mes - 1 };
      pintarCalendario();
    });

    adelante.addEventListener('click', () => {
      mesVisible = mesVisible.mes === 12
        ? { anio: mesVisible.anio + 1, mes: 1 }
        : { anio: mesVisible.anio, mes: mesVisible.mes + 1 };
      pintarCalendario();
    });

    actualizarResumen();
    pintarCalendario();
    traerAgenda();
  }
</script>
