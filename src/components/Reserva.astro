  }

  .anticipo__aviso {
    display: flex;
    gap: 8px;
    margin-top: 18px;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--ink-3);
  }

  .anticipo__aviso :global(svg) {
    width: 15px;
    height: 15px;
    flex: none;
