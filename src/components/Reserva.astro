  }

  .confirmada__lista dt {
    font-size: 0.688rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .confirmada__lista dd {
    margin-top: 5px;
    font-size: 0.925rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .confirmada__texto {
    margin-top: 22px;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--ink-2);
  }

  /* --------------------------- Anticipo por SPEI --------------------------- */

  /* La confirmación va centrada, pero aquí hay datos que se leen y se copian:
     una CLABE centrada se sigue con el dedo peor que una alineada a la
     izquierda. El bloque rompe el centrado a propósito. */
  .anticipo {
    margin-top: 26px;
    padding: clamp(18px, 2.4vw, 26px);
    border: 1px solid var(--linea-fuerte);
    border-top: 3px solid var(--alerta);
    border-radius: var(--r-card);
    background: var(--sup);
    text-align: left;
  }

  .anticipo__cabeza {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .anticipo__cabeza :global(svg) {
    width: 22px;
    height: 22px;
    flex: none;
    color: var(--alerta);
  }

  .anticipo__cabeza h4 {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    line-height: 1.3;
  }

  .anticipo__texto {
    margin-top: 10px;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--ink-2);
  }

  /* El reloj es lo único que cambia solo en esta pantalla, así que se separa
     del resto con fondo propio: hay que encontrarlo de reojo al volver. */
  .anticipo__reloj {
    margin-top: 14px;
    padding: 9px 13px;
    border-radius: var(--r-inner);
    background: var(--alerta-tenue);
    color: var(--alerta);
    font-size: 0.813rem;
    font-weight: 600;
  }

  .anticipo__reloj[data-agotado='true'] {
    background: var(--sup-2);
    color: var(--ink-2);
    font-weight: 500;
  }

  .anticipo__datos {
    display: grid;
    gap: 14px;
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid var(--linea);
  }

  .anticipo__datos dt {
    font-size: 0.688rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .anticipo__datos dd {
    margin-top: 4px;
    font-size: 0.925rem;
    font-weight: 500;
    color: var(--ink);
  }

  /* Monto y CLABE en tabular: los dígitos alineados se comparan contra la
     pantalla del banco sin contarlos uno por uno. */
  .anticipo__monto {
