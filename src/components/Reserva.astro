    gap: 8px;
    margin-top: 20px;
    padding: 0 0 0 20px;
    font-size: 0.844rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .anticipo__pasos li::marker { color: var(--acento-texto); font-weight: 700; }

  .anticipo__subida {
    display: grid;
    gap: 10px;
    margin-top: 22px;
