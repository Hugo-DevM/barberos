    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px;
    margin-top: 26px;
  }

  /* ------------------------ Menú de calendarios ---------------------------- */

  .calendarios { position: relative; }

  .calendarios__flecha {
    width: 15px !important;
    height: 15px !important;
    transition: transform 0.2s var(--ease);
  }

  #cal-abrir[aria-expanded='true'] .calendarios__flecha { transform: rotate(180deg); }

